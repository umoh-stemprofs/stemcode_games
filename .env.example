# ---------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# No secret has a default in code: the API refuses to start if a
# required value is missing.
# ---------------------------------------------------------------

# dev | test | staging | prod
APP_ENV=dev

# Required. Local Postgres is fine. See README "no Docker" section.
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5433/stem_games

# Optional in dev (D-34). Leave empty to use the in-memory cache/queue.
# Required in staging/prod: startup refuses to run without it.
REDIS_URL=

# Public base URL of the web app: the origin the CSRF check and the WebSocket
# handshake accept, and the base of every invite link.
# Optional in dev (loopback is accepted automatically). REQUIRED in staging and
# prod: startup refuses to run without it, because the only accepted origin
# would otherwise be localhost and every real write would be refused.
APP_BASE_URL=http://localhost:3000

# Required. Signs 15-minute access tokens (P1-T02). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real value; staging/prod refuse to boot without it.
SECRET_KEY=

# Optional overrides. Defaults are in app/core/config.py.
# ACCESS_TOKEN_TTL_S=900
# REFRESH_TOKEN_TTL_S=1209600
# COOKIE_SECURE=true
