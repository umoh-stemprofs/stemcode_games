# ---------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# No secret has a default in code: the API refuses to start if a
# required value is missing.
# ---------------------------------------------------------------

# dev | test | staging | prod
APP_ENV=dev

# Required. Local Postgres is fine. See README "no Docker" section.
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5433/stem_games

# Optional in dev (D-34). Leave empty to use the in-memory cache/queue.
# Required in staging/prod: startup refuses to run without it.
REDIS_URL=

# Public base URL of the web app, used for invite links.
APP_BASE_URL=http://localhost:3000
